{
    "name": "neo-digital/contao-frontendeditor-bundle",
    "type": "contao-bundle",
    "description": "Edit content directly on the page in Contao's front-end preview: headlines, texts and images inline (also of news and events), all other fields in Contao's regular form in a sidebar, with Contao's permissions and versions; translation of language versions, AI writing aid, SEO and accessibility checks.",
    "keywords": [
        "contao",
        "contao-bundle",
        "frontend editor",
        "frontend editing",
        "inline editing",
        "live editing",
        "wysiwyg",
        "visual editor",
        "preview",
        "translation",
        "multilingual",
        "news",
        "events",
        "seo",
        "accessibility",
        "ai"
    ],
    "homepage": "https://store.neo-digital.at/extensions/frontend-editor",
    "license": "proprietary",
    "authors": [
        {
            "name": "NEO Digital"
        }
    ],
    "support": {
        "issues": "https://github.com/NEO-Digital-AT/contao-frontendeditor-bundle/issues",
        "source": "https://github.com/NEO-Digital-AT/contao-frontendeditor-bundle"
    },
    "require": {
        "php": "^8.2",
        "ext-ctype": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "contao/core-bundle": "^5.3 || ^6.0",
        "doctrine/dbal": "^3.6 || ^4.0",
        "friendsofsymfony/http-cache": "^2.15.1 || ^3.0",
        "neo-digital/contao-basic-bundle": "^1.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "scssphp/scssphp": "^1.11 || ^2.0",
        "symfony/asset": "^6.4 || ^7.0 || ^8.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/event-dispatcher": "^6.4 || ^7.0 || ^8.0",
        "symfony/filesystem": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-client-contracts": "^3.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/routing": "^6.4 || ^7.0 || ^8.0",
        "symfony/security-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/security-core": "^6.4 || ^7.0 || ^8.0",
        "symfony/security-csrf": "^6.4 || ^7.0 || ^8.0",
        "symfony/translation-contracts": "^3.0"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "contao/manager-plugin": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.5",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0",
        "symfony/translation": "^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "suggest": {
        "terminal42/contao-changelanguage": "Links the pages of the language versions; needed for editing language versions side by side and for creating them with a new page (Plus)."
    },
    "autoload": {
        "psr-4": {
            "Neo\\FrontendEditorBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Neo\\FrontendEditorBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "contao-manager-plugin": "Neo\\FrontendEditorBundle\\ContaoManager\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": false,
            "contao/manager-plugin": false,
            "php-http/discovery": false
        }
    }
}
